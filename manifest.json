{
  "manifest_version": 3,
  "name": "Virtual Cube Overlay",
  "version": "1.0",
  "description": "Floating overlay for Virtual Cube",
  "permissions": ["activeTab", "scripting", "storage"],
  "action": {
    "default_title": "Toggle Virtual Cube Overlay"
  },
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [{
    "resources": ["overlay.css"],
    "matches": ["<all_urls>"]
  }]
}
